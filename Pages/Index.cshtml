@page
@model IndexPage
@{
    
}

<main>
  <section class="hero" role="banner" aria-hidden="true">
    <img src="~/images/drehleiter.jpg" alt="Drehleiter" class="hero-img" />
  </section>

  <!-- Hero text moved below the image to keep the title off the picture -->
  <section class="hero-content">
    <div class="container card" style="max-width:1100px;">
      <h1>Herzlich willkommen bei der Feuerwehr Waldenbuch</h1>
      <p class="lead">Einsatzbereit. Nahbar. Für Sie da — 24/7. Erfahren Sie mehr über unsere Aufgaben, Nachwuchs und aktuelle Einsätze.</p>
     
    </div>
  </section>

  <section class="section" id="mehr">
    <div class="features">
      <div class="card">
        <h3>Aktuelle Einsätze</h3>
        <p>Aktuelle Einsatzberichte für Bürgerinnen und Bürger.</p>
      </div>
      <div class="card">
        <h3>Berichte</h3>
        <p>Aktuelle Meldungen</p>
      </div>
      <div class="card">
        <h3>Mitmachen &amp; Ausbildung</h3>
        <p>Informationen zur Jugendfeuerwehr, Ausbildungsterminen und wie Sie uns unterstützen können.</p>
      </div>
    </div>
  </section>

  <section class="section" id="kontakt">
    <div class="card" style="max-width:900px; margin:0 auto;">
      <h2>Kontakt</h2>
      <p>Bei dringenden Notfällen wählen Sie bitte die 112. Für allgemeine Anfragen verwenden Sie unser Kontaktformular</p>
      <p style="margin-top:1rem"><a class="btn-cta" href="/Kontakt">Zum Kontaktformular</a></p>
    </div>
  </section>
</main>
