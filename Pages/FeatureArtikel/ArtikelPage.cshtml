@page "/artikel/{id?}/{text?}"
@model ArtikelPage
@{

}


@foreach (var item in Model.ArtikelListe)
{


	<p>
		<b>@item.Ueberschrift</b><br />
		<a href="/artikel/@item.Id/@MainData.UrlFriendly(item.Ueberschrift)">
			@item.Datum.ToLongDateString()
		</a>
	</p>

}

@if (Model.Artikel != null)
{

	<div style="padding-left: 20px; padding-top: 30px;">
		<a href="javascript:history.back()">zurück</a>
	</div>

	<h2>@Model.Artikel.Ueberschrift</h2>
	<p>
		von @Model.Artikel.Von<br>
		<br />
		<u style="font-size: 1.1em;">@Model.Artikel.Datum.ToLongDateString() </u>

	</p>
	<p style="line-height: 1.7em; font-size: 1.1em; width: 60%; text-align: justify">
		@Html.Raw(Model.Artikel.Inhalt.Replace(Environment.NewLine, "<br><br>"))
	</p>

}